# KisanOS Backend — Environment Variables
# Copy this to .env and fill in production values.

# ── Authentication ──────────────────────────────────────────
API_KEY=kisanos-dev-key-change-in-production

# ── CORS (comma-separated origins, or * for all) ───────────
CORS_ORIGINS=["*"]

# ── External API Keys ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
GEMINI_API_KEY=your-gemini-api-key
OWM_API_KEY=your-openweathermap-key
DATA_GOV_API_KEY=your-data-gov-key
NASA_FIRMS_KEY=your-nasa-firms-key
FAST2SMS_API_KEY=your-fast2sms-api-key

# ── VAPID Web Push keys (generate with: python -m py_vapid --gen-key) ──
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@yourdomain.app

# ── Cache TTLs (seconds) ───────────────────────────────────
WEATHER_CACHE_TTL=300
FORECAST_CACHE_TTL=1800
FIRMS_CACHE_TTL=600
MARKET_CACHE_TTL=900

# ── Debug ──────────────────────────────────────────────────
DEBUG=false
