# KisanOS Backend — Environment Variables
# Copy this to .env and fill in production values.

# ── Authentication ──────────────────────────────────────────
API_KEY=kisanos-dev-key-change-in-production

# ── CORS (comma-separated origins, or * for all) ───────────
CORS_ORIGINS=["*"]

# ── External API Keys ──────────────────────────────────────
OWM_API_KEY=bd5e378503939ddaee76f12ad7a97608
DATA_GOV_API_KEY=579b464db66ec23bdd000001cdd3946e44ce4aab825747b0bc4f6e0d
NASA_FIRMS_KEY=6a8dded48b9e7f3f8fb71ac4c5a45e89

# ── Cache TTLs (seconds) ───────────────────────────────────
WEATHER_CACHE_TTL=300
FORECAST_CACHE_TTL=1800
FIRMS_CACHE_TTL=600
MARKET_CACHE_TTL=900

# ── Debug ──────────────────────────────────────────────────
DEBUG=false
