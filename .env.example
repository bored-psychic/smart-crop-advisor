# KisanOS Backend — Environment Variables
# Copy this to .env and fill in production values.

# ── Authentication ──────────────────────────────────────────
# API_KEY: shared secret for service-to-service / cron routes only.
# The browser frontend does NOT use this — it authenticates via
# phone+OTP and a per-user JWT (see JWT_SECRET below).
API_KEY=replace-with-random-32+-char-string
# JWT_SECRET: HS256 signing key for per-user tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-random-64+-char-string
# Optional tunables for the OTP/JWT flow:
# JWT_TTL_HOURS=24
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5

# ── PII Encryption (P1 Task 3) ─────────────────────────────────
# APP_PEPPER: any 32+ char random string. Mixed into SHA-256(phone)
# before storage so a stolen DB cannot be brute-forced against the
# E.164 keyspace. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_PEPPER=replace-with-random-32+-char-string
# FERNET_KEY: base64url-encoded 32-byte Fernet key. Encrypts the
# phone ciphertext column AND feedback audio clips on disk.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-fernet-key

# ── CORS (comma-separated origins, or * for all) ───────────
CORS_ORIGINS=["*"]

# ── External API Keys ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
GEMINI_API_KEY=your-gemini-api-key
OWM_API_KEY=your-openweathermap-key
DATA_GOV_API_KEY=your-data-gov-key
NASA_FIRMS_KEY=your-nasa-firms-key
FAST2SMS_API_KEY=your-fast2sms-api-key
# Dedicated demo login: this one number skips SMS (saves the ~₹5 quick-route
# charge) and shows the OTP on screen, even in production. All other numbers
# still get a real SMS. Leave blank to disable. Never use a real user's number.
DEMO_PHONE=1234567890

# ── VAPID Web Push keys (generate with: python -m py_vapid --gen-key) ──
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@yourdomain.app

# ── Cache TTLs (seconds) ───────────────────────────────────
WEATHER_CACHE_TTL=300
FORECAST_CACHE_TTL=1800
FIRMS_CACHE_TTL=600
MARKET_CACHE_TTL=900

# ── Debug ──────────────────────────────────────────────────
DEBUG=false
